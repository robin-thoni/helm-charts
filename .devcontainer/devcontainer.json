{
	"name": "Ubuntu",
	"image": "mcr.microsoft.com/devcontainers/base:noble",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {}
	},

	"mounts": [
		"source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind",
		"source=${localEnv:HOME}/.docker,target=/home/vscode/.docker,type=bind",
		"source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind"
	],
	"postStartCommand": ".devcontainer/devcontainer/postStartCommand.sh",
	"customizations": {
        "vscode": {
            "extensions": [
                "tim-koehler.helm-intellisense",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
	"remoteEnv": {
		"LOCAL_USER": "${localEnv:USER}",
		"LOCAL_HOST": "172.17.0.1",
		"EDITOR": "code -w"
	}
}
